// This app shares byg-global's Postgres database, but does NOT own
// migrations for these tables. `hosting_services` / `hosting_invoices`
// (plus their FKs into byg-global's User/business_profiles tables) are
// created and migrated from byg-global/prisma/migrations -- this schema
// only describes them so this app's Prisma Client can read/write them.
// Never run `prisma migrate dev|deploy` from this project.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  active
  inactive
  banned
}

// Read-only from this app's perspective: admin login checks isAdmin/status/
// passwordHash against byg-global's real User table (same credentials as
// the ecommerce admin login), so operators don't need a second password.
model User {
  id           String     @id
  email        String     @unique
  passwordHash String?
  isAdmin      Boolean    @default(false)
  status       UserStatus @default(active)
}

enum HostingServiceStatus {
  active
  payment_due
  overdue
  grace_period
  suspended
  cancelled
}

enum HostingInvoiceStatus {
  pending
  paid
  overdue
  void
}

model HostingService {
  id                String               @id @default(cuid())
  businessProfileId String?
  userId            String?
  customerName      String
  customerEmail     String
  customerPhone     String?
  domain            String
  planName          String
  monthlyPriceKes   Float
  billingDayOfMonth Int                  @default(1)
  graceDays         Int                  @default(5)
  invoiceLeadDays   Int                  @default(5)
  status            HostingServiceStatus @default(active)
  notes             String?
  setupFeeKes         Float                @default(0)
  setupInstallmentKes Float                @default(0)
  billingStartsAt     DateTime?
  suspendAfter        DateTime?
  reminderSentAt      DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  invoices          HostingInvoice[]
  payments          HostingPayment[]

  @@index([status])
  @@index([businessProfileId])
  @@index([userId])
  @@map("hosting_services")
}

model HostingInvoice {
  id                 String               @id @default(cuid())
  hostingServiceId   String
  periodStartsAt     DateTime
  periodEndsAt       DateTime
  amountKes          Float
  setupPortionKes    Float                @default(0)
  dueDate            DateTime
  status             HostingInvoiceStatus @default(pending)
  payToken           String               @unique @default(cuid())
  checkoutRequestId  String?
  mpesaReceiptNumber String?
  paidAt             DateTime?
  remindersSentAt    Json?
  metadata           Json?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  hostingService     HostingService       @relation(fields: [hostingServiceId], references: [id], onDelete: Cascade)

  @@unique([hostingServiceId, periodStartsAt])
  @@index([status, dueDate])
  @@index([checkoutRequestId])
  @@map("hosting_invoices")
}

enum HostingPaymentMethod {
  mpesa
  manual
}

enum HostingPaymentStatus {
  pending
  completed
  failed
}

model HostingPayment {
  id                 String               @id @default(cuid())
  hostingServiceId   String
  amountKes          Float
  method             HostingPaymentMethod
  status             HostingPaymentStatus @default(pending)
  checkoutRequestId  String?              @unique
  mpesaReceiptNumber String?
  phoneNumber        String?
  note               String?
  paidAt             DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  hostingService     HostingService       @relation(fields: [hostingServiceId], references: [id], onDelete: Cascade)

  @@index([hostingServiceId, status])
  @@map("hosting_payments")
}
