# Same Postgres database as byg-global. This app does not own migrations
# for hosting_services/hosting_invoices -- see prisma/schema.prisma.
DATABASE_URL=

# Admin login checks email/password against byg-global's real User table
# (same DB, same bcrypt passwordHash, requires isAdmin + active status) --
# no separate password for this app. Generate a long random value for
# HOSTING_SESSION_SECRET; it signs this app's own login session cookie.
HOSTING_SESSION_SECRET=

# Same n8n "send-email" webhook byg-global uses. N8N_EMAIL_WEBHOOK_URL /
# N8N_WEBHOOK_SEND_EMAIL are known-dead in production (an old workflow's
# webhook ID, 404s "not registered" regardless of encoding) -- set them
# for parity with byg-global's env anyway, but N8N_BASE_URL is what
# actually matters: src/lib/email.ts falls through to
# "${N8N_BASE_URL}/webhook/send-email", which is the one confirmed
# active webhook. HOSTING_EMAIL_WEBHOOK_SECRET must match byg-global's
# N8N_WEBHOOK_SECRET (same shared HMAC secret) if byg-global ever sets one.
N8N_EMAIL_WEBHOOK_URL=
N8N_WEBHOOK_SEND_EMAIL=
N8N_BASE_URL=
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=
HOSTING_EMAIL_WEBHOOK_SECRET=
HOSTING_EMAIL_FROM=hosting@captyn.shop

# Protects POST /api/cron/billing-cycle (call it daily from n8n's scheduler
# or any external cron, with header `x-internal-key: <this value>`).
HOSTING_AUTOMATION_KEY=

# Used to build pay links in emails (e.g. https://hosting.captyn.shop).
HOSTING_APP_BASE_URL=http://localhost:3100

# byg-global's origin, so the pay page can call its M-PESA STK-init API
# (cross-origin browser fetch). byg-global must also allow this exact
# origin via its HOSTING_APP_ALLOWED_ORIGINS env var.
NEXT_PUBLIC_BYG_GLOBAL_BASE_URL=
