# Same Postgres database as byg-global. This app does not own migrations
# for hosting_services/hosting_invoices -- see prisma/schema.prisma.
DATABASE_URL=

# Single-operator admin login (no user table). Generate a long random
# value for HOSTING_SESSION_SECRET; it signs the login session cookie.
HOSTING_ADMIN_PASSWORD=
HOSTING_SESSION_SECRET=

# Same n8n "send-email" webhook byg-global uses. HOSTING_EMAIL_WEBHOOK_SECRET
# must match byg-global's N8N_WEBHOOK_SECRET (same shared HMAC secret).
N8N_EMAIL_WEBHOOK_URL=
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=
HOSTING_EMAIL_WEBHOOK_SECRET=
HOSTING_EMAIL_FROM=hosting@captyn.shop

# Protects POST /api/cron/billing-cycle (call it daily from n8n's scheduler
# or any external cron, with header `x-internal-key: <this value>`).
HOSTING_AUTOMATION_KEY=

# Used to build pay links in emails (e.g. https://hosting.captyn.shop).
HOSTING_APP_BASE_URL=http://localhost:3100

# byg-global's origin, so the pay page can call its M-PESA STK-init API
# (cross-origin browser fetch). byg-global must also allow this exact
# origin via its HOSTING_APP_ALLOWED_ORIGINS env var.
NEXT_PUBLIC_BYG_GLOBAL_BASE_URL=
